# The catalog: reading · systemone · h2o-lightning-4b · clef-flash — comma-separated, preferred first.
# A name outside it stops ejev at start and lists the valid ones.
JEV_BACKENDS=h2o-lightning-4b
# Starts the servers of the chosen catalog entries; keep it equal to JEV_BACKENDS.
COMPOSE_PROFILES=${JEV_BACKENDS}

# reading — any OpenAI-compatible LLM speaking vLLM's logprob dialect (/tokenize + /v1/completions with
# logprob_token_ids). Required when JEV_BACKENDS includes reading.
# JEV_READING_URL=http://vllm:8000/v1
# JEV_READING_MODEL=your-served-model
# JEV_READING_KEY=local

# systemone — any native /v1/systemone server. Required when JEV_BACKENDS includes systemone.
# JEV_SYSTEMONE_URL=https://api.typesafe.ai
# JEV_SYSTEMONE_KEY=

# h2o-lightning-4b on your GPU: ~9.3 GB of weights; GPU_UTIL is the share of the whole card vLLM takes.
# H2O_GPU_UTIL=0.85
# H2O_MAX_LEN=32768
# H2O_TWO_WAY=1

# Bearer key clients must send; unset accepts any.
# JEV_API_KEY=
